# Copy to .env and fill in real values. .env is gitignored.

# --- Azure OpenAI (used for slip <-> credit matching) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# --- Upstream services (where ocr_slip and ocr_mutasi run) ---
OCR_SLIP_URL=http://127.0.0.1:8100
OCR_MUTASI_URL=http://127.0.0.1:8000

# --- Service ---
APP_HOST=0.0.0.0
APP_PORT=8200

# --- Timeouts & limits ---
LLM_REQUEST_TIMEOUT_S=60
UPSTREAM_TIMEOUT_S=120
# Absolute rupiah tolerance — default = "exact match with float-safety wiggle".
# Bump to e.g. 1000 if your real-world payments have cents-rounding or
# small fee adjustments.
MATCH_AMOUNT_TOLERANCE_RP=1
MAX_FILES=50

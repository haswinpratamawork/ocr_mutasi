.DS_Store
__pycache__/
*.py[cod]

# Local inputs may contain private salary data.
input/*.pdf
!input/.gitkeep

# Generated parser/UI output.
output*/
web_output/

# Per-request runs written by app.py's /parse handler — each run carries the
# uploaded PDFs and the rendered extracted/summary JSON. They're ephemeral
# per-tenant artifacts; never check them in (would leak PII).
runs/

# Local environment files.
.env
.venv/
venv/

# Editor/system files.
.idea/
.vscode/
